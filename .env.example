# Vorlage für die Secrets der Edge Function "calendar-feed".
# Nur Platzhalter – echte Werte gehören NICHT in das Repo, sondern
# ausschließlich in die Supabase-Secrets:
#
#   supabase secrets set ICS_EW="..." ICS_AAA="..." ICS_PRIVAT="..." \
#     PLANER_TOKEN="..." ALLOWED_ORIGIN="https://..."
#
# Die veröffentlichten ICS-Links wirken wie Schlüssel: Wer sie kennt, sieht
# den Kalender. Deshalb niemals committen und nicht in den Client-Code schreiben.

# Veröffentlichte ICS-Links (leere oder fehlende Quelle wird übersprungen)
ICS_EW=
ICS_AAA=
ICS_PRIVAT=

# Langer Zufallswert, den die App im Header "Authorization: Bearer ..." sendet
# Erzeugen z. B. mit: openssl rand -base64 48
PLANER_TOKEN=

# Origin der App, nur von dort erlaubt die Function Zugriffe
ALLOWED_ORIGIN=https://othpa89-del.github.io
